<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.system.mapper.SysUserMapper">

    <sql id="userDepartmentRange">
        FROM sys_user FORCE INDEX (idx_sys_user_dept_id) WHERE del_flag='0' AND
        <choose><when test="deptIds != null and !deptIds.isEmpty()">
            dept_id IN <foreach collection="deptIds" item="id" open="(" separator="," close=")">#{id}</foreach>
        </when><otherwise>1=0</otherwise></choose>
    </sql>

    <select id="selectUserDepartments" resultType="java.lang.Long">
        SELECT dept_id <include refid="userDepartmentRange"/>
    </select>

    <select id="lockUserDepartments" resultType="java.lang.Long">
        SELECT dept_id <include refid="userDepartmentRange"/> ORDER BY dept_id,user_id FOR UPDATE
    </select>

</mapper>
